    if not recepcion_iniciada:
        threadRecepcion = threading.Thread(target=recepcion, daemon=True)
        threadRecepcion.start()
        # Recuerda que el lector ya está funcionando para no iniciar otro hilo.
        recepcion_iniciada = True

    print('Recepció iniciada')
 
    

def PaClick ():
    # Envía al Arduino el comando para detener temporalmente la adquisición.
    # El texto debe coincidir con el comando que el programa del Arduino reconoce.
    mensaje = "Parar\n"
    mySerial.write(mensaje.encode('utf-8'))


def ReClick ():
    # Envía al Arduino el comando para reanudar la adquisición de datos.
    mensaje = "Reanudar\n"
    mySerial.write(mensaje.encode('utf-8'))


# Crea la ventana principal, que contendrá todos los demás elementos.
window = Tk()
window.geometry("1200x600")
# La ventana usa filas y columnas. El peso permite que se expandan al cambiar
# el tamaño de la ventana.
window.rowconfigure(0, weight=1)
window.rowconfigure(1, weight=1)

window.columnconfigure(0, weight=1)
window.columnconfigure(1, weight=1)
window.columnconfigure(2, weight=1)
window.columnconfigure(3, weight=10)

# Crea el texto del título y lo coloca en la cuadrícula de la ventana.
tituloLabel = Label(window, text = "Mando de sensor de temperatura", font=("Courier", 20, "italic"))
tituloLabel.grid(row=0, column=0, columnspan=1, padx=5, pady=5, sticky=N + S + E + W)

# Crea un recuadro con título para agrupar los botones de control.
button_graph_frame = LabelFrame(window, text ='Botones de control de la gráfica')
button_graph_frame.grid(row=1, column=0, columnspan=1, padx=5, pady=5, sticky=N + S + E + W)
# Hace que las tres columnas del recuadro puedan repartirse el espacio.
button_graph_frame.rowconfigure(0, weight=1)
button_graph_frame.columnconfigure(0, weight=1)
button_graph_frame.columnconfigure(1, weight=1)
button_graph_frame.columnconfigure(2, weight=1)

# Crea los botones. "command" indica qué función se ejecutará al hacer clic.
InButton = Button(button_graph_frame, text="Iniciar", bg='lime', fg="black",command=InClick)
InButton.grid(row=0, column=0, padx=5, pady=5, sticky=N + S + E + W)

PaButton = Button(button_graph_frame, text="Pausar", bg='red', fg="black",command=PaClick)
PaButton.grid(row=0, column=1, padx=5, pady=5, sticky=N + S + E + W)

ReButton = Button(button_graph_frame, text="Reanudar", bg='orange', fg="black",command=ReClick)
ReButton.grid(row=0, column=2, padx=5, pady=5, sticky=N + S + E + W)

# Crea el recuadro para la gráfica. Al abrir la ventana estará vacío:
# el canvas se añade al recuadro al pulsar "Iniciar".
graph_frame = LabelFrame(window, text ='Gráfica')
# Coloca el recuadro a la derecha y permite que crezca con la ventana.
graph_frame.grid(row=0, column=1, columnspan=3, rowspan=2, padx=5, pady=5, sticky=N + S + E + W)
# Permite que el canvas ocupe el espacio disponible dentro del recuadro.
graph_frame.rowconfigure(0, weight=1)
graph_frame.columnconfigure(0, weight=1)

# Inicia el bucle de Tkinter: muestra la ventana y espera clics y otros eventos.
window.mainloop()
