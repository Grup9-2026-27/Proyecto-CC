import serial  # Comunicación con el Arduino por el puerto serie.
import threading  # Permite leer datos en segundo plano sin congelar la ventana.
import time  # Para medir el tiempo transcurrido y que el eje X avance también durante la pausa.
from tkinter import messagebox  # Para mostrar la ventana de alarma con el botón OK.
from queue import Empty, Queue  # Cola para compartir las temperaturas entre tareas.
from tkinter import *  # Herramientas para crear la ventana y sus controles.
from matplotlib.figure import Figure  # Figura que contendrá el gráfico.
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg  # Integra Matplotlib con Tkinter.

# Puerto al que está conectado el Arduino; puede cambiar en cada ordenador.
device = 'COM8'
mySerial = serial.Serial(device, baudrate=9600)  # Abre la conexión serie a 9600 baudios

# Listas para almacenar el historial de puntos representados en las gráficas
temperaturas = []
medias = []
eje_x = []

# Colas seguras entre hilos (thread-safe) para pasar datos desde el hilo serie a la interfaz gráfica
temperaturas_pendientes = Queue()
alarmas_pendientes = Queue()

# Banderas para evitar abrir múltiples ventanas emergentes repetidas por un mismo fallo continuo
alarma_sensor_activa = False
alarma_com_activa = False
alarma_dist_activa = False

# Referencias globales a los objetos de la gráfica Matplotlib
canvas = None
ax = None
ax_media = None
plot_line = None
plot_line_media = None

# Banderas de control para asegurar que el hilo de lectura y el refresco de gráfica se lancen una sola vez
recepcion_iniciada = False
actualizacion_programada = False

INTERVALO = 3      # Intervalo esperado (en segundos) entre lecturas del satélite para escalar el eje X
t_inicio = None    # Marca de tiempo del primer dato recibido para calcular el tiempo relativo

# Variables para el cálculo de la media móvil y control de sobretemperatura cuando se calcula en tierra
ultimas_10 = []
limite_temp = 30.0
consecutivas_sup = 0


# Función que se ejecuta en un hilo secundario leyendo continuamente los datos de la estación de tierra
def recepcion():
    global mySerial, t_inicio, alarma_sensor_activa, alarma_com_activa, alarma_dist_activa, consecutivas_sup
    
    while True:
        if mySerial.in_waiting > 0:  # Comprueba si hay bytes esperando en el búfer del puerto serie
            line = mySerial.readline().decode('utf-8', errors='ignore').rstrip()  # Lee y decodifica una línea completa
            print(line)
            trozos = line.split(':')  # Divide la trama recibida usando ':' como separador
            
            # Código 1: recepción de temperatura y humedad (formato 1:temp:hum o 1:temp:hum:media)
            if len(trozos) >= 3 and trozos[0] == '1':
                alarma_sensor_activa = False  # Restablece la alarma del DHT11 si llegan datos válidos
                temperatura = float(trozos[1])
                humedad = float(trozos[2])

                if len(trozos) >= 4:
                    # Si la trama trae 4 campos, la media ya viene calculada desde el satélite
                    media = float(trozos[3])
                else:
                    # Si trae 3 campos, Python calcula la media móvil de las últimas 10 muestras
                    ultimas_10.append(temperatura)
                    if len(ultimas_10) > 10:
                        ultimas_10.pop(0)  # Elimina la muestra más antigua para mantener máximo 10
                    media = sum(ultimas_10) / len(ultimas_10)

                    # Comprueba si la media supera el límite 3 veces consecutivas
                    if media > limite_temp:
                        consecutivas_sup += 1
                        if consecutivas_sup >= 3:
                            alarmas_pendientes.put(f"3 medias consecutivas superiores al límite ({limite_temp} °C).")
                            mySerial.write("2:\n".encode('utf-8'))  # Ordena activar el zumbador en tierra
                            consecutivas_sup = 0
                    else:
                        consecutivas_sup = 0

                if t_inicio is None:
                    t_inicio = time.time()  # Fija el instante cero al recibir el primer dato
                x = (time.time() - t_inicio) / INTERVALO  # Calcula la posición en el eje X según el tiempo real
                temperaturas_pendientes.put((x, temperatura, media))  # Envía el punto a la cola de la gráfica

            # Código 2: alarma de sobretemperatura detectada directamente por el satélite
            elif len(trozos) >= 1 and trozos[0] == '2':
                alarmas_pendientes.put(f"Satélite: 3 medias consecutivas superiores al límite ({limite_temp} °C).")

            # Código 3: fallo confirmado del sensor DHT11
            elif len(trozos) >= 1 and trozos[0] == '3':
                if not alarma_sensor_activa:
                    alarma_sensor_activa = True
                    alarmas_pendientes.put("Fallo en el sensor de temperatura y humedad (DHT11).")

            # Código 6: pérdida de enlace con el satélite (más de 5 s sin recibir tramas)
            elif len(trozos) >= 1 and trozos[0] == '6':
                if not alarma_com_activa:
                    alarma_com_activa = True
                    alarmas_pendientes.put("Se ha perdido la comunicación con el satélite.")

            # Código 8: enlace con el satélite recuperado
            elif len(trozos) >= 1 and trozos[0] == '8':
                alarma_com_activa = False

            # Código 11: telemetría del radar ultrasónico (11:ángulo:distancia)
            elif len(trozos) >= 3 and trozos[0] == '11':
                if trozos[2] != '0':  # Si la distancia es distinta de 0, el sensor vuelve a funcionar bien
                    alarma_dist_activa = False

            # Código 13: fallo confirmado del sensor ultrasónico HC-SR04
            elif len(trozos) >= 1 and trozos[0] == '13':
                if not alarma_dist_activa:
                    alarma_dist_activa = True
                    alarmas_pendientes.put("Fallo en el sensor de distancia (HC-SR04).")


# Extrae los puntos pendientes de la cola y actualiza las dos gráficas periódicamente
def actualizar_grafica():
    while True:
        try:
            x, temperatura, media = temperaturas_pendientes.get_nowait()  # Extrae punto sin bloquear
        except Empty:
            break  # Sale del bucle cuando ya no quedan puntos pendientes

        # Si hubo una pausa prolongada (salto > 1.5 intervalos), inserta un hueco (NaN) para cortar la línea
        if eje_x and x - eje_x[-1] > 1.5:
            eje_x.append(eje_x[-1] + 1)
            temperaturas.append(float('nan'))
            medias.append(float('nan'))

        # Añade los nuevos valores a las listas y actualiza los datos de ambas curvas
        eje_x.append(x)
        temperaturas.append(temperatura)
        medias.append(media)
        plot_line.set_data(eje_x, temperaturas)
        plot_line_media.set_data(eje_x, medias)
        ax.set_title("Temperatura (lectura " + str(int(eje_x[-1])) + ")")

    canvas.draw_idle()  # Redibuja el lienzo de forma eficiente
    window.after(100, actualizar_grafica)  # Vuelve a programar esta función dentro de 100 ms


# Comprueba cada 200 ms si hay alarmas en la cola para mostrarlas en ventana emergente
def revisar_alarmas():
    try:
        texto = alarmas_pendientes.get_nowait()
    except Empty:
        texto = None
    if texto is not None:
        messagebox.showerror("ALARMA", texto)  # Bloquea hasta que el usuario pulsa OK
        mySerial.write("7:\n".encode('utf-8'))  # Envía código 7 para silenciar el zumbador en tierra
    window.after(200, revisar_alarmas)


# Acción del botón "Iniciar": crea las gráficas si no existen y arranca la recepción
def InClick():
    global canvas, ax, ax_media, plot_line, plot_line_media, recepcion_iniciada, actualizacion_programada

    if canvas is None:
        figure = Figure(figsize=(6, 4.5), dpi=100)
        ax = figure.add_subplot(211)        # Subgráfica superior: temperatura instantánea
        ax_media = figure.add_subplot(212)  # Subgráfica inferior: media móvil de 10 muestras
        figure.tight_layout(pad=2.0)

        # Configura límites de ejes y etiquetas de ambas gráficas
        ax.set(xlim=(0, 100), ylim=(20, 40), ylabel="Temp (°C)")
        ax_media.set(xlim=(0, 100), ylim=(20, 40), ylabel="Media 10 (°C)", title="Media móvil (10 últimas)")

        # Inicializa las líneas vacía roja (temperatura) y azul (media móvil)
        plot_line, = ax.plot([], [], 'r-')
        plot_line_media, = ax_media.plot([], [], 'b-')

        # Incrusta la figura de Matplotlib dentro del marco de Tkinter
        canvas = FigureCanvasTkAgg(figure, master=graph_frame)
        canvas.draw()
        canvas_graph = canvas.get_tk_widget()
        canvas_graph.config(width=600, height=450)
        canvas_graph.grid(row=0, column=0, padx=5, pady=5, sticky=N + S + E + W)

    # Inicia el ciclo periódico de refresco de la gráfica
    if not actualizacion_programada:
        actualizacion_programada = True
        window.after(100, actualizar_grafica)

    # Lanza el hilo en segundo plano (daemon) encargado de escuchar el puerto serie
    if not recepcion_iniciada:
        threadRecepcion = threading.Thread(target=recepcion, daemon=True)
        threadRecepcion.start()
        recepcion_iniciada = True

    print('Recepció iniciada')


