    # "global" permite guardar aquí el gráfico y los indicadores definidos arriba.
    global canvas, ax, plot_line, recepcion_iniciada, actualizacion_programada

    # En el primer clic crea la gráfica; los siguientes clics reutilizan el mismo canvas.
    if canvas is None:
        # Crea el área completa del gráfico y añade un conjunto de ejes.
        figure = Figure(figsize=(6, 3), dpi=100)
