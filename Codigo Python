import serial  # Comunicación con el Arduino por el puerto serie.
import threading  # Permite leer datos en segundo plano sin congelar la ventana.
from queue import Empty, Queue  # Cola para compartir las temperaturas entre tareas.
from tkinter import *  # Herramientas para crear la ventana y sus controles.
from matplotlib.figure import Figure  # Figura que contendrá el gráfico.
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg  # Integra Matplotlib con Tkinter.

# Puerto al que está conectado el Arduino; puede cambiar en cada ordenador.
device = 'COM3'
# La velocidad debe coincidir con la configurada en el programa del Arduino.
mySerial = serial.Serial(device, baudrate=9600)

# Cada punto del gráfico tendrá un número de lectura (eje X) y una temperatura (eje Y).
temperaturas = []
eje_x = []
# El hilo de lectura pone aquí los datos; Tkinter los recoge para dibujarlos con seguridad.
temperaturas_pendientes = Queue()
# Se dejan vacíos para que la gráfica no se cree hasta pulsar "Iniciar".
canvas = None
ax = None
plot_line = None
# Estos indicadores impiden iniciar varias veces las mismas tareas al repetir clics.
recepcion_iniciada = False
actualizacion_programada = False


def recepcion():
    # Lee continuamente los mensajes enviados por el Arduino.
    # Se ejecuta en segundo plano para que la ventana siga respondiendo.
    global mySerial
    
    while True:
        # in_waiting indica cuántos bytes están esperando para ser leídos.
        if mySerial.in_waiting > 0:
            # Lee una línea, convierte los bytes a texto y elimina el salto final.
            line = mySerial.readline().decode('utf-8').rstrip()
            # Muestra el mensaje recibido también en la consola.
            print(line)
            # Por ejemplo, "T:24.5" se convierte en ["T", "24.5"].
            trozos = line.split(':')
            
            # Solo procesa mensajes que empiezan por "T" y contienen un valor.
            if len(trozos) >= 2 and trozos[0] == 'T':
                # El dato llega como texto; se convierte a número decimal.
                temperatura = float(trozos[1])
                # Deja el valor en la cola para que el hilo de Tkinter lo dibuje.
                temperaturas_pendientes.put(temperatura)


def actualizar_grafica():
    # Tkinter llama a esta función cada 100 ms para revisar si hay datos nuevos.
    # Procesa todas las temperaturas que se hayan acumulado antes de redibujar.
    while True:
        try:
            # Obtiene el dato sin esperar; la ventana no se queda detenida si no hay datos.
            temperatura = temperaturas_pendientes.get_nowait()
        except Empty:
            # La cola está vacía: termina este ciclo de lectura.
            break

        # Usa el número de puntos existentes como índice de la nueva lectura.
        eje_x.append(len(eje_x))
        # Guarda la temperatura que se usará como valor vertical del punto.
        temperaturas.append(temperatura)
        # Actualiza los puntos de la línea roja que ya está creada.
        plot_line.set_data(eje_x, temperaturas)
        # Cambia el título para mostrar el número de la última lectura.
        ax.set_title(str(eje_x[-1]))

    # Solicita a Matplotlib que redibuje el canvas cuando Tkinter pueda hacerlo.
    canvas.draw_idle()
    # Programa la siguiente revisión dentro de 100 milisegundos (0,1 segundos).
    window.after(100, actualizar_grafica)

