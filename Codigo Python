        canvas_graph.config(width=600, height=300)
        canvas_graph.grid(row=0, column=0, padx=5, pady=5, sticky=N + S + E + W)

    # Inicia las revisiones periódicas de la cola, pero solo una vez.
    if not actualizacion_programada:
        actualizacion_programada = True
